# Provider credentials and model selection for the Kern AI proposal plane.
#
# Copy to `.env` (gitignored) and fill in. The adapter reads this file only when
# the variable is not already set in the environment, so an explicit `export`
# always wins.
#
# The key is a host secret. It is sent in exactly one place — the Authorization
# header of the inference request — and is never logged, digested, recorded in
# provenance, or included in a prompt.

# ollama-cloud | ollama | nebius | nebius-us-central1 | nebius-eu-west1 | custom
#
# `ollama-cloud` is the default and what the demos use: inference runs in
# Ollama's account over HTTPS, so the machine running Gazebo needs no GPU, no
# model weights, and no local daemon.
# `ollama` is a local `ollama serve` daemon and needs no key at all.
KERN_MODEL_PROVIDER=ollama-cloud

# The key for the chosen provider. Get an Ollama Cloud key from
# https://ollama.com/settings/keys
OLLAMA_API_KEY=
# NEBIUS_API_KEY=
# KERN_MODEL_API_KEY=   # overrides the provider's own variable

# REQUIRED, and there is deliberately no default.
#
# Verify it first, against the account the key belongs to:
#
#     cd adapters/openai-compatible && cargo run --bin verify
#
# A model identifier from documentation is a hint. The identifier that binary
# prints for these credentials is the fact. Ollama Cloud identifiers carry no
# `-cloud` suffix — that suffix belongs to a local daemon proxying a cloud
# model, which is a different provider profile.
#
# The demos are configured against NVIDIA Nemotron 3 Super: 120B, cloud-hosted,
# and a thinking model. Ollama Cloud answers to the bare name, untagged — but
# confirm it against your own key rather than trusting this line.
KERN_MODEL_ID=nemotron-3-super

# Optional.
#
# KERN_MODEL_BASE_URL overrides the profile's base URL. Leave it unset for
# ollama-cloud: the profile already supplies https://ollama.com/v1, and a stale
# value here is how a cloud key ends up aimed at an old local address. When a
# key is being sent, a plaintext http:// URL to anything but the loopback
# interface is refused outright.
# KERN_MODEL_BASE_URL=
# KERN_MODEL_TIMEOUT_MS=60000
# KERN_MODEL_MAX_TOKENS=512
# KERN_MODEL_TEMPERATURE=0.2
# plain | json_object | json_schema. Default `plain`: constrained prompting plus
# the strict local parser. Provider-side enforcement is defence in depth, never
# a reason to trust the output.
#
# Set it for a thinking model. Where reasoning lands inside the message content
# rather than beside it, the response stops being one JSON document and the
# parser refuses it — correctly, and the fix belongs in configuration. Fall back
# to `json_object`, then `plain`, if a gateway rejects the request.
KERN_MODEL_RESPONSE_FORMAT=json_schema

# A thinking model spends tokens before it answers, and this bounds the
# completion as a whole. A 120B model on a shared endpoint is also slower than a
# local small one; the timeout is Kern's own deadline and is not an authority
# lifetime.
KERN_MODEL_MAX_TOKENS=1024
KERN_MODEL_TIMEOUT_MS=120000

# A substring filter for the `verify` listing only, when a catalogue is long.
KERN_MODEL_MATCH=nemotron
