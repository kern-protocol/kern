# Provider credentials and model selection for the Kern AI proposal plane.
#
# Copy to `.env` (gitignored) and fill in. The adapter reads this file only when
# the variable is not already set in the environment, so an explicit `export`
# always wins.
#
# The key is a host secret. It is sent in exactly one place — the Authorization
# header of the inference request — and is never logged, digested, recorded in
# provenance, or included in a prompt.

# nebius | nebius-us-central1 | nebius-eu-west1 | ollama | ollama-cloud | custom
# `ollama` is a local `ollama serve` daemon and needs no key at all.
KERN_MODEL_PROVIDER=ollama

# The key for the chosen provider.
# NEBIUS_API_KEY=
# OLLAMA_API_KEY=
# KERN_MODEL_API_KEY=   # overrides the provider's own variable

# REQUIRED, and there is deliberately no default.
#
# Verify it first, against the account the key belongs to:
#
#     cd adapters/openai-compatible && cargo run --bin verify
#
# A model identifier from documentation is a hint. The identifier that binary
# prints for these credentials is the fact.
KERN_MODEL_ID=

# Optional.
# KERN_MODEL_BASE_URL=
# KERN_MODEL_TIMEOUT_MS=60000
# KERN_MODEL_MAX_TOKENS=512
# KERN_MODEL_TEMPERATURE=0.2
# plain | json_object | json_schema. Default `plain`: constrained prompting plus
# the strict local parser. Provider-side enforcement is defence in depth, never
# a reason to trust the output.
# KERN_MODEL_RESPONSE_FORMAT=plain
